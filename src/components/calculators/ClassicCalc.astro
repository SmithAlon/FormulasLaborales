<div class="md:w-full w-1/2 justify-center content-center p-4 set-right">        
    <label for="calc-input" class="text-muted mt-3 text-sm max-w-md justify-right">Realiza tus propios cálculos</label>
    <input 
        type="text" 
        id="calc-input" 
        placeholder="Ej: (15 * 4) / 2" 
        class="text-right text-md p-2 text-gray-800 bg-white border-2 border-gray-300 focus:outline-none focus:border-black focus:ring-4 focus:ring-gray-100 transition-all duration-200"
        autocomplete="off"
    >
    <p id="error-msg" class="text-red-500 text-sm mt-2 text-center hidden">Operación inválida</p>
</div>

<script>
    // Seleccionamos los elementos y definimos explícitamente sus tipos
const inputField = document.getElementById('calc-input') as HTMLInputElement | null;
const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement | null;

// Nos aseguramos de que los elementos existen en el DOM antes de asignar eventos
if (inputField && errorMsg) {
    inputField.addEventListener('keydown', (event: KeyboardEvent) => {
        
        if (event.key === 'Enter') {
            event.preventDefault();
            
            const expression: string = inputField.value.trim();
            
            if (expression === '') return;

            const isValidMath: boolean = /^[0-9+\-*/().\s]+$/.test(expression);

            if (isValidMath) {
                try {
                    // new Function devuelve un tipo 'any' por defecto, lo tratamos como 'unknown' para mayor seguridad
                    const result: unknown = new Function('return ' + expression)();
                    
                    // Verificamos que el resultado sea un número válido
                    if (typeof result === 'number' && !isNaN(result) && isFinite(result)) {
                        inputField.value = result.toString();
                        errorMsg.classList.add('hidden');
                    } else {
                        throw new Error('Resultado no numérico');
                    }
                } catch (error: unknown) {
                    showError(inputField, errorMsg);
                }
            } else {
                showError(inputField, errorMsg);
            }
        }
    });
}

/**
 * Muestra el mensaje de error y aplica estilos visuales al input
 */
function showError(input: HTMLInputElement, errorText: HTMLParagraphElement): void {
    errorText.classList.remove('hidden');
    
    input.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-100');
    
    setTimeout(() => {
        input.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-100');
    }, 1500);
}
</script>
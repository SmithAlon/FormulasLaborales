---
interface Props {
  disclaimer?: string;
}

const {
  disclaimer = '⚠️ Los resultados son estimaciones basadas en la LFT vigente (marzo 2026). No representan valores oficiales ni asesoría legal. Sitio independiente, sin afiliación gubernamental.',
} = Astro.props;
---

<footer class="border-t-2 border-ink max-w-5xl mx-auto px-6 py-6">
  <div class="header-stripe mb-4 h-0.75"></div>
  <p class="font-mono text-xs text-muted text-center">{disclaimer}</p>
</footer>

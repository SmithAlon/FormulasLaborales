---
import ClassicCalc from './calculators/ClassicCalc.astro'

interface Props {
  subtitle?: string;
}

const { subtitle = 'República Mexicana · Ley Federal del Trabajo' } = Astro.props;
---

<div class="header-stripe"></div>

<header class="flex justify-between border-b-2 border-ink px-6 py-8 max-w-5xl mx-auto">
  <div class="justify-between flex-wrap gap-4">
    <div>
      <p class="font-mono text-xs text-muted uppercase tracking-widest mb-2">{subtitle}</p>
      <h1 class="font-display text-5xl md:text-6xl font-black leading-tight text-ink">
        Fórmulas<br><em class="text-rust">Laborales</em>
      </h1>
      <p class="text-muted mt-3 text-sm max-w-md">
        Calculadora basada en la LFT vigente. Aguinaldo, Finiquito, Liquidación, SDI, ISR y Propinas.
      </p>
    </div>
  </div>
  <div class="content-right">
    <div class="text-right hidden md:block">
      <p class="font-mono text-xs text-muted">Art. 76, 80, 87, 162 LFT</p>
      <p class="font-mono text-xs text-muted">Reforma DOF 27-12-2022</p>
    </div>
    <ClassicCalc />
  </div>
</header>
